{
  "name": "@dontpanic/area42",
  "version": "0.3.0",
  "description": "Futuristic HUD visualization engine for real-time system monitoring",
  "type": "module",
  "main": "dist/area42.js",
  "module": "dist/area42.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/area42.js",
      "require": "./dist/area42.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./world": {
      "import": "./dist/world/index.js",
      "types": "./dist/world/index.d.ts"
    }
  },
  "peerDependencies": {
    "three": "^0.183.0",
    "troika-three-text": "^0.52.0"
  },
  "peerDependenciesMeta": {
    "three": { "optional": true },
    "troika-three-text": { "optional": true }
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "AREA42OS.md",
    "AREA42_V2_RFC.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "lint": "eslint src/",
    "test": "vitest",
    "prepare": "npm run build || true"
  },
  "keywords": [
    "hud",
    "visualization",
    "dashboard",
    "real-time",
    "canvas",
    "webgl",
    "monitoring",
    "agent",
    "nats"
  ],
  "author": "DONTPANIC AS <frode@dontpanic.no>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TilSjoes/area42.git"
  },
  "devDependencies": {
    "@types/three": "^0.183.1",
    "three": "^0.183.2",
    "troika-three-text": "^0.52.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2"
  }
}